{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vesperwise.com"
        }
      ],
      "destination": "https://www.vesperwise.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reset-free-credits",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sweep-bulk-jobs",
      "schedule": "*/15 * * * *"
    }
  ]
}
